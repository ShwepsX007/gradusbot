[Unit]
Description=Gradus Polymarket public trades observer (read only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gradus-web
WorkingDirectory=/opt/gradusbot-web
ExecStart=/bin/sh /opt/gradusbot-web/web/run_copy_observer.sh
Restart=on-failure
RestartSec=10
UMask=0077

[Install]
WantedBy=multi-user.target
