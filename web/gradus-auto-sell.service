[Unit]
Description=Gradus Polymarket automatic SELL worker (real orders)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gradus-web
WorkingDirectory=/opt/gradusbot-web
ExecStart=/bin/sh /opt/gradusbot-web/web/run_auto_sell.sh
Restart=on-failure
RestartSec=10
UMask=0077

[Install]
WantedBy=multi-user.target
