# =========================================================
#  Пример .env для gradusbot
#  Скопируйте в .env и подставьте свои значения.
#  Формат строгий: КЛЮЧ=значение
#  Двоеточие вместо "=" не работает — строка просто игнорируется.
#  Кавычки и пробелы вокруг "=" не нужны.
# =========================================================

# --- Telegram ---
TOKEN=123456:AA...

# --- Polymarket: подписант и кошелёк ---
# Приватный ключ подписанта (signer). С 0x или без — бот сам нормализует.
POLY_PRIVATE_KEY=0x...

# Адрес кошелька аккаунта: polymarket.com -> меню профиля.
# Это НЕ адрес подписанта. Можно оставить пустым — тогда официальный SDK
# сам найдёт депозит-кошелёк вашего подписанта.
POLY_FUNDER=0x...

# Тип кошелька: 3 = Deposit Wallet (по умолчанию с мая 2026),
# 2 = Gnosis Safe (MetaMask/Rabby), 1 = старый Magic/Google прокси, 0 = голый EOA.
POLY_SIGNATURE_TYPE=3

# Какой клиент использовать для ордеров:
#   unified — только официальный polymarket-client (нужен Python 3.11+)
#   v2      — только старый py-clob-client-v2
#   auto    — старый, а при отказе кошелька автоматически переключиться на новый
POLY_SDK=unified

# --- Relayer API key ---
# polymarket.com -> Settings -> API Keys -> Relayer API Keys -> Create.
# ВАЖНО: имена именно такие, с префиксом POLY_ и через "=".
POLY_RELAYER_API_KEY=019ea188-...
POLY_RELAYER_API_KEY_ADDRESS=0xAc9CD2...

# --- L2-креды CLOB (необязательно) ---
# Если их нет, официальный SDK выведет их сам при старте.
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# --- Погодные API ---
WU_API_KEY_1=
WU_API_KEY_2=
CHECKWX_API_KEY=
